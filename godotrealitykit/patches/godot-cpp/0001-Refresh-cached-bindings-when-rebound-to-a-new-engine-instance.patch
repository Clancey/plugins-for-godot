+// Incremented every time the library is bound to an engine instance. A library image can be
+// bound to several engine instances over its lifetime, and anything cached from a previous
+// binding (method binds, class registration) must be fetched again for the new one.
+extern std::atomic<uint32_t> binding_generation;
+
+class MethodBindCache {
+	std::atomic<GDExtensionMethodBindPtr> method_bind{ nullptr };
+	std::atomic<uint32_t> generation{ 0 };
+
+public:
+	template <typename F>
+	inline GDExtensionMethodBindPtr get(F p_fetch) {
+		uint32_t current = binding_generation.load(std::memory_order_acquire);
+		if (generation.load(std::memory_order_acquire) == current) {
+			return method_bind.load(std::memory_order_relaxed);
+		}
+		GDExtensionMethodBindPtr fetched = p_fetch();
+		method_bind.store(fetched, std::memory_order_relaxed);
+		generation.store(current, std::memory_order_release);
+		return fetched;
+	}
+};
+
 } // namespace internal
 
